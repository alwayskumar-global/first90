# Copy to .env.local (never commit .env.local). Server-side only: do not prefix with NEXT_PUBLIC_.

# Event-issued Qloo key (required). Hackathon keys only work against the hackathon base URL.
QLOO_API_KEY=
# Optional. Defaults to https://hackathon.api.qloo.com
QLOO_BASE_URL=

# Secret used to sign plan sessions so a tampered session is rejected (recommended, >= 16 characters).
# If unset, a signing key is derived from QLOO_API_KEY. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Optional place-search service for the Location step (Photon-compatible). Defaults to https://photon.komoot.io
# No key needed. https only (http allowed for localhost).
GEOCODER_BASE_URL=

# Test-only switches for the end-to-end suite; leave unset. IMAGE_VERIFY=off skips the server's image checks (and the
# venue-site / Wikimedia fallbacks). IMAGE_ALLOW_LOOPBACK=true lets the image checks reach 127.0.0.1.
# IMAGE_VERIFY=
# IMAGE_ALLOW_LOOPBACK=

# Set to "true" to expose /api/diagnostics/* outside development. Leave unset in production.
DIAGNOSTICS_ENABLED=

# Usage protection (per server instance). Defaults shown.
# RATE_LIMIT_BUILDS_PER_MIN=6            plan builds per visitor per minute
# RATE_LIMIT_REVISIONS_PER_MIN=20        feedback revisions per visitor per minute
# RATE_LIMIT_LOOKUPS_PER_MIN=40          interest lookups per visitor per minute
# RATE_LIMIT_GLOBAL_BUILDS_PER_MIN=40    plan builds across all visitors per minute
# RATE_LIMIT_GLOBAL_LOOKUPS_PER_MIN=200  lookups and revisions across all visitors per minute
# MAX_CONCURRENT_BUILDS=4                simultaneous plan builds
# RATE_LIMIT_GEOCODE_PER_MIN=60          place searches per visitor per minute
# QLOO_CACHE_TTL_SECONDS=1800            in-memory cache of Qloo responses (0 disables)
# GEOCODER_CACHE_TTL_SECONDS=3600        in-memory cache of place searches (0 disables)
