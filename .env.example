# Copy to .env.local (never commit .env.local). Server-side only: do not prefix with NEXT_PUBLIC_.
# Event-issued Qloo key. Hackathon keys only work against the hackathon base URL.
QLOO_API_KEY=
# Optional. Defaults to https://hackathon.api.qloo.com
QLOO_BASE_URL=
# Optional. Set to "true" to enable /api/diagnostics/qloo outside development.
DIAGNOSTICS_ENABLED=
